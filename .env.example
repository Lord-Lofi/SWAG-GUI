# -----------------------------------------------------------------------------
# SWAG Config GUI - Environment Template
#
# SECURITY NOTICE - THIS FILE IS PUBLIC
# -------------------------------------
# This file contains ONLY placeholder values. It exists to document what
# variables are required. Your real values go in .env, which is gitignored.
#
# Rules:
#   1. Never put a real value in this file.
#   2. Never commit .env to version control.
#   3. If you add a new env var, add a placeholder entry here.
# -----------------------------------------------------------------------------

# -- Git ----------------------------------------------------------------------
# The public repository URL the entrypoint fetches from on startup.
REPO_URL=https://github.com/YOUR_GITHUB_USERNAME/SWAG-GUI.git

# Which version to run: a release tag (recommended, e.g. 0.2.0) or a branch
# (main). With a tag, nothing changes until you choose to move to a new tag.
REPO_REF=YOUR_RELEASE_TAG

# Check the release tag's GPG signature before running it. Needs REPO_REF to
# be a tag you signed (git tag -s) and your public key mounted at
# SIGNING_KEY_FILE (see docker-compose.example.yml).
VERIFY_SIGNATURES=false
SIGNING_KEY_FILE=/app/trusted-signing-key.asc

# -- SWAG Container Names -----------------------------------------------------
# Must match the container_name values in your SWAG docker-compose files.
# Do not commit real container names - use placeholders here.
SWAG_EXTERNAL_CONTAINER=SWAG_EXTERNAL_CONTAINER_NAME
SWAG_INTERNAL_CONTAINER=SWAG_INTERNAL_CONTAINER_NAME

# -- Volume Mount Paths (inside this container) -------------------------------
# These match the volume mount targets defined in docker-compose.example.yml.
# Change only if you alter the mount targets in your compose file.
SWAG_EXTERNAL_CONFS_PATH=/mnt/swag-external/proxy-confs
SWAG_INTERNAL_CONFS_PATH=/mnt/swag-internal/proxy-confs

# -- File Ownership -----------------------------------------------------------
# Must match the PUID and PGID configured in your SWAG containers.
# The GUI container runs as this user (not root), so the files it writes are
# owned by SWAG's user automatically. Rebuild after changing these.
FILE_UID=YOUR_PUID
FILE_GID=YOUR_PGID

# -- Docker Socket Proxy ------------------------------------------------------
# URL of the Tecnativa docker-socket-proxy sidecar.
# Do not change this unless you rename the service in your compose file.
DOCKER_SOCKET_PROXY_URL=http://socket-proxy:2375

# -- Ports --------------------------------------------------------------------
# PORT: internal port - proxied by swag-internal, not exposed directly.
PORT=3000

# BREAKGLASS_PORT: direct LAN access port that bypasses SWAG + Authelia, for
# recovery when SWAG is down. 0 = disabled (default).
# To enable: set a port (e.g. 8080), set BREAKGLASS_PASSWORD_HASH below, and
# uncomment the break-glass port line in docker-compose.yml.
BREAKGLASS_PORT=0

# Login for the break-glass port. Create the hash with:
#   npm run hash-password
# and paste the printed line here, replacing the placeholder. Only the hash
# goes in this file, never the password. Never commit your real .env.
BREAKGLASS_USER=admin
BREAKGLASS_PASSWORD_HASH=YOUR_PASSWORD_HASH
