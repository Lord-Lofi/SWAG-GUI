# ─────────────────────────────────────────────────────────────────────────────
# SWAG Config GUI — Environment Template
#
# SECURITY NOTICE — THIS FILE IS PUBLIC
# ──────────────────────────────────────
# This file contains ONLY placeholder values. It exists to document what
# variables are required. Your real values go in .env, which is gitignored.
#
# Rules:
#   1. Never put a real value in this file.
#   2. Never commit .env to version control.
#   3. If you add a new env var, add a placeholder entry here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Git ───────────────────────────────────────────────────────────────────────
# The public repository URL the entrypoint pulls from on startup.
REPO_URL=https://github.com/YOUR_GITHUB_USERNAME/swag-config-gui.git

# ── SWAG Container Names ──────────────────────────────────────────────────────
# Must match the container_name values in your SWAG docker-compose files.
# Do not commit real container names — use placeholders here.
SWAG_EXTERNAL_CONTAINER=SWAG_EXTERNAL_CONTAINER_NAME
SWAG_INTERNAL_CONTAINER=SWAG_INTERNAL_CONTAINER_NAME

# ── Volume Mount Paths (inside this container) ────────────────────────────────
# These match the volume mount targets defined in docker-compose.example.yml.
# Change only if you alter the mount targets in your compose file.
SWAG_EXTERNAL_CONFS_PATH=/mnt/swag-external/proxy-confs
SWAG_INTERNAL_CONFS_PATH=/mnt/swag-internal/proxy-confs

# ── File Ownership ────────────────────────────────────────────────────────────
# Must match the PUID and PGID configured in your SWAG containers.
# Written files will be chown'd to these values so SWAG can read them.
FILE_UID=YOUR_PUID
FILE_GID=YOUR_PGID

# ── Docker Socket Proxy ───────────────────────────────────────────────────────
# URL of the Tecnativa docker-socket-proxy sidecar.
# Do not change this unless you rename the service in your compose file.
DOCKER_SOCKET_PROXY_URL=http://socket-proxy:2375

# ── Ports ─────────────────────────────────────────────────────────────────────
# PORT: internal port — proxied by swag-internal, not exposed directly.
PORT=3000

# BREAKGLASS_PORT: direct LAN access port, bypasses SWAG + Authelia.
# Used for recovery when SWAG is down. Set to 0 to disable.
# Bind this to your LAN IP in docker-compose.example.yml — never 0.0.0.0.
BREAKGLASS_PORT=8080
